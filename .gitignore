data_*/
mono_crash.*.json

# Android build output and template
android/
*.apk
*.apk.idsig
*.aab

# Signing material and credentials (never commit)
*.keystore
*.jks
*credentials*
export_credentials.cfg
.env
*.env

# Temp / OS junk
*.tmp
*.log
*~
.DS_Store
Thumbs.db
*.uid
__pycache__/
