; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SAPIENTIA"
config/description="Top-down JRPG prototype for mobile"
config/version="0.19"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"

[autoload]

GameState="*res://scripts/game_state.gd"
Transition="*res://scripts/transition.gd"
Dialog="*res://scenes/ui/dialog_box.tscn"
Story="*res://scripts/story.gd"
Crt="*res://scripts/ui/crt_overlay.gd"
Settings="*res://scripts/settings.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=4

